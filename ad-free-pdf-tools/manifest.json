{
  "manifest_version": 3,
  "name": "Clean PDF Processor Pro",
  "author": "Anabhay Ventures",
  "homepage_url": "https://anabhay.in/",
  "version": "1.0",
  "description": "Merge PDFs locally without ads or server uploads.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "icon.png"
  }
}
